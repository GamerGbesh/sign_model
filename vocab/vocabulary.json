    "friend": {
      "enabled": true,
      "english": "friend",
      "twi": "adamfo",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Also written adamfoɔ. Yɔnkoɔ is another valid word for friend/companion."
    },
    "goodbye": {
      "enabled": true,
      "english": "goodbye",
      "twi": "nante yie",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Literally 'walk well'. Other forms include baabae and nkyirioo."
    },
    "hello": {
      "enabled": true,
      "english": "hello",
      "twi": "akwaaba",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Akwaaba literally means 'welcome' and is commonly used as a greeting. For conversational greetings, ɛte sɛn?, wo ho te sɛn?, or mekyea wo oo may be more natural depending on context."
    },
    "help": {
      "enabled": true,
      "english": "help",
      "twi": "boa",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Boa is the verb 'to help'. The noun 'help' is mmoa."
    },
    "name": {
      "enabled": true,
      "english": "name",
      "twi": "edin",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Edin is the noun 'name'. The verb 'to name' is bɔ din. For 'my name is', use the phrase 'me din de ...'."
    },
    "no": {
      "enabled": true,
      "english": "no",
      "twi": "dabi",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Use as the standalone negative response 'no'. Sentence-level negation in Twi generally requires a negative verb form rather than simply replacing 'no' with dabi."
    },
    "please": {
      "enabled": true,
      "english": "please",
      "twi": "mepa wo kyɛw",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Also commonly written mepaakyɛw. Mesrɛ wo is another valid form meaning 'please/I beg you'."
    },
    "sorry": {
      "enabled": true,
      "english": "sorry",
      "twi": "kafra",
      "status": "verified",
      "verified_by": "LEARNAKAN English-Twi Dictionary",
      "audio": null,
      "notes": "Kafra is used as an exclamation meaning 'sorry'. Kosɛ is another listed form. Context may require a fuller expression."
    },
    "thank_you": {
      "enabled": true,
